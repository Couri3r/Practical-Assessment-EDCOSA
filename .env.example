# Copy this file to .env.local and fill in your key.
# .env.local is gitignored and is only read on the server, never sent to the browser.

# Google Gemini key from https://aistudio.google.com/apikey
# Leave empty to run with the built-in mock AI.
GEMINI_API_KEY=

# Optional. Defaults to gemini-3.6-flash.
# GEMINI_MODEL=gemini-3.6-flash

# Optional. Set to "mock" to force the mock even when a key is present.
# AI_PROVIDER=mock

# --- Storage -----------------------------------------------------------------
# Not needed locally: with none of these set, requests are saved to
# data/requests.json.
#
# Required when DEPLOYED, because serverless hosts have a read-only filesystem.
# Vercel's Upstash integration injects the KV_* pair for you; a standalone
# Upstash database gives you the UPSTASH_* pair. Either works.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
