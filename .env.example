# Copy this file to .env.local and fill in your key.
# .env.local is gitignored and is only read on the server, never sent to the browser.

# Google Gemini key from https://aistudio.google.com/apikey
# Leave empty to run with the built-in mock AI.
GEMINI_API_KEY=

# Optional. Defaults to gemini-3.6-flash.
# GEMINI_MODEL=gemini-3.6-flash

# Optional. Set to "mock" to force the mock even when a key is present.
# AI_PROVIDER=mock
